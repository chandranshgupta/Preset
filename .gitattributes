# Auto detect text files and perform LF normalization
* text=auto

# Unix shell scripts and hooks must have LF endings
*.sh text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf
preset/payload/.githooks/* text eol=lf

# Windows scripts
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
